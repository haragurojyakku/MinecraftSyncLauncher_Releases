{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Debug launcher (GUI)",
            "request": "launch",
            "mainClass": "dev.haraguro.modserverplaymanager.launcher.gui.LauncherMain",
            "projectName": "launcher",
            "vmArgs": "-Dmcsync.downloadAssets=false"
        },
        {
            "type": "java",
            "name": "Attach to packaged exe",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005,
            "projectName": "launcher",
            "preLaunchTask": "Launch packaged exe (debug)"
        },
        {
            "type": "java",
            "name": "Debug server-manager (launches + supervises server/)",
            "request": "launch",
            "mainClass": "dev.haraguro.modserverplaymanager.servermanager.ServerManagerApp",
            "projectName": "server-manager",
            "vmArgs": "-Dmcsync.server.dir=${workspaceFolder}/../server"
        }
    ]
}
