{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build debug app image",
            "type": "shell",
            "command": "${workspaceFolder}\\gradlew.bat",
            "args": [
                ":launcher:jpackageAppImage",
                "-PdebugPort=5005"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Launch packaged exe (debug)",
            "type": "shell",
            "command": "\"${workspaceFolder}\\launcher\\build\\jpackage\\ModServerPlayManagerByHaraguro\\ModServerPlayManagerByHaraguro.exe\"",
            "dependsOn": "Build debug app image",
            "dependsOrder": "sequence",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^never matches (nothing)$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Listening for transport",
                    "endsPattern": "^Listening for transport"
                }
            }
        }
    ]
}
